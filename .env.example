# CyberGuard AI — backend environment.
#
# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored — never commit a real key.
#
# Nothing here is required to boot: without a key the server still serves
# GET /api/v1/get-all and the documentation, and POST /api/v1/check-url
# answers 503 (provider_not_configured) instead of pretending to work.

# Port the API listens on. Docker Compose uses this as the published host
# port; the container itself always listens on 8080.
APP_PORT=8080

# MongoDB connection string (required at runtime, not to boot).
# On the host:  mongodb://localhost:27017 (or your Atlas/mongodb+srv URI).
# In Docker: docker-compose.yml overrides this to mongodb://mongodb:27017,
# so the value here is what a non-Docker run uses.
MONGODB_URI=mongodb://localhost:27017

# Database name. The service uses exactly one collection (url_submissions)
# and creates its index on startup.
MONGODB_DATABASE=cyberguard

# Hybrid Analysis v2 base URL.
#
# There is no `www` in the default on purpose: this is the host the official
# v2 specification declares, and the www host answers 301 to it — a redirect
# a Go client does not replay a POST body across, so using www would make
# every scan fail. Leave the default unless you host your own proxy.
HYBRID_ANALYSIS_BASE_URL=https://hybrid-analysis.com/api/v2

# Hybrid Analysis API key (Private API v2). Required for check-url to work;
# obtainable from your Hybrid Analysis account settings.
# Keep this file ignored in git; never print it in logs or docs.
HYBRID_ANALYSIS_API_KEY=

# Per-request deadline for the provider call, in Go duration units
# (30s, 1m, ...). Capped at 5m by configuration validation.
HYBRID_ANALYSIS_TIMEOUT=30s

# Optional: which scanners the provider runs. Must be one of the documented
# `scan_type` values (validated at startup):
#   all, all_lookup, all_scan, lookup_ha, lookup_cleandns, lookup_bforeai,
#   scan_crowdstrike_ml, scan_metadefender, scan_urlscanio,
#   scan_scamadviser, scan_criminalip, scan_vipre
# Default when unset: all.
#HYBRID_ANALYSIS_SCAN_TYPE=all

# Pause between result retrievals while one check-url request waits for a
# scan to finish. The documented retrieval endpoint GET /quick-scan/{id} is
# called immediately, then again with this pause, until the provider reports
# `finished: true` or the request budget (HYBRID_ANALYSIS_TIMEOUT) runs out.
# Validated: > 0, at most 1m. Default when unset: 1s.
#HYBRID_ANALYSIS_POLL_INTERVAL=1s

# How long a completed assessment stays reusable as a cached result before
# the next check-url call assesses the URL again (in place; never a second
# record). Validated: > 0, at most 336h (14 days). Default when unset: 24h.
#ASSESSMENT_TTL=24h

# Exact browser origins allowed to call the API from JavaScript,
# comma separated, no trailing slash. "*" is rejected at startup: the API has
# no authentication, and an open origin list would let any page anywhere
# spend this deployment's provider quota.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# These two only matter for the docker compose `go` toolchain service, which
# writes build caches into ./.cache on your behalf.
# Check with: id -u && id -g
LOCAL_UID=1000
LOCAL_GID=1000
