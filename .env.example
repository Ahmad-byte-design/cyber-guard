# CyberGuard AI — local environment.
#
# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored. Never commit real keys.
#
# Values here are read by docker-compose.yml. The defaults below assume the
# Compose service names, so containers talk to "mongodb" rather than 127.0.0.1.

# --- runtime ---------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# Graceful-shutdown budget. In-flight requests get this long to finish before
# connections are force-closed.
SHUTDOWN_TIMEOUT=15s

# Bounds each readiness dependency probe, individually.
HEALTH_CHECK_TIMEOUT=2s

# Compose substitutes these into image build args (version stamping).
# No secret is ever a build arg: an ARG/ENV holding a key stays recoverable
# from image history even if a later layer unsets it.
VERSION=dev
COMMIT=unknown
BUILD_TIME=unknown

# --- MongoDB (authoritative store) -----------------------------------------
MONGODB_DATABASE=cyberguard
# Overridden per-service in compose to mongodb://mongodb:27017.
MONGODB_CONNECT_TIMEOUT=10s
MONGODB_PING_TIMEOUT=5s

# --- provider selection ----------------------------------------------------
# Which backend analyses submitted URLs.
#
#   mock             Analyses URLs in-process. No request leaves this machine, no
#                    API key is required, and results are deterministic — the
#                    same URL always gives the same verdict.
#   hybrid-analysis  The real Hybrid Analysis sandbox service.
#
# There is no fallback between them. Selecting hybrid-analysis without a key is
# a startup error rather than a quiet switch to the mock, because a silent
# fallback would let the real integration rot while its tests still passed.
#
# Local development and testing:  ANALYSIS_PROVIDER=mock
ANALYSIS_PROVIDER=mock

# --- provider (hybrid-analysis only) ---------------------------------------
# Ignored entirely when ANALYSIS_PROVIDER=mock.
#
# Verified against the official specification (OpenAPI 3.0.0, docs v2.38.0) on
# 2026-10-16. Full contract: docs/verified/hybrid-analysis-v2-contract.md
#
# Note there is no `www` in the base URL; that is what the specification declares.
HYBRID_ANALYSIS_BASE_URL=https://hybrid-analysis.com/api/v2

# Leave empty to run without remote analysis. The worker logs that submissions
# are disabled; the API reports the provider as a degraded readiness sub-check.
#
# Automated submission requires usage approval before commercial release:
# docs/decisions/0010-hybrid-analysis-licensing.md
HYBRID_ANALYSIS_API_KEY=

# Sandbox environment. Documented IDs: 140 Windows 11, 160 Windows 10,
# 330 Linux Ubuntu 24.04, 430 macOS Tahoe, 200 Android, 120/110/100 Windows 7.
# 140 is the default because phishing kits target Windows browsers.
HYBRID_ANALYSIS_ENVIRONMENT_ID=140

# Per-request deadline. Must stay well under any worker job lease.
HYBRID_ANALYSIS_TIMEOUT=30s

# Retries bound the backoff for *idempotent GETs only*. Submissions are never
# retried: the specification declares no idempotency token, so a timed-out
# submission may already have been accepted upstream.
HYBRID_ANALYSIS_MAX_RETRIES=3
HYBRID_ANALYSIS_RETRY_BASE=500ms

# --- secrets ---------------------------------------------------------------
# Backend-only HMAC key for URL fingerprinting. Required: without it the
# service reports not-ready and refuses URL submissions.
# Generate one with:
#   openssl rand -hex 32
# Changing this invalidates every stored fingerprint, i.e. the whole cache.
URL_FINGERPRINT_HMAC_KEY=

# Key for encrypting a raw URL between accepting a submission and the worker
# handing it to the provider. Required for the worker to resume a submission.
#
# Deliberately a DIFFERENT secret from the fingerprint key: rotating the
# fingerprint key invalidates the whole cache, while rotating this one only
# strands in-flight jobs. See docs/decisions/0013-durable-jobs-and-url-privacy.md
#
#   openssl rand -hex 32
URL_ENCRYPTION_KEY=

# How long an encrypted URL survives if explicit deletion never happens.
# This is a crash-window safety net, not a retention policy: the worker deletes
# the record the moment the submission completes.
TRANSIENT_URL_TTL=10m

# --- worker ---------------------------------------------------------------
# How often a provider report is polled for a running scan, and the ceiling on
# backoff between polls. Keep it well under WORKER_POLL_DEADLINE.
WORKER_POLL_INTERVAL=5s

# How long one job waits for a terminal provider report before it is recorded
# as timed_out. A scan that runs out of time gets no verdict at all — never
# no_threat_detected.
WORKER_POLL_DEADLINE=5m

# Jobs processed at once. This is a self-inflicted-rate-limit control: too high
# and the provider throttles us, spending quota on rejections.
WORKER_CONCURRENCY=4

# How often stalled scans are re-enqueued, and how long a scan may go without
# progressing before it is treated as lost.
#
# WORKER_STALL_THRESHOLD must exceed both WORKER_RECONCILE_INTERVAL (or healthy
# scans would be re-enqueued forever) and HYBRID_ANALYSIS_TIMEOUT (or work
# about to succeed would be abandoned). The config loader rejects violations.
WORKER_RECONCILE_INTERVAL=30s
WORKER_STALL_THRESHOLD=2m

# How long a consumer waits for work before re-reading its cancellation. Sets
# shutdown latency.
WORKER_CLAIM_BLOCK=1s

# Pause between empty claims. MongoDB has no blocking claim primitive, so an
# idle consumer polls; this bounds how hard "no work" queries the database. It is
# separate from WORKER_CLAIM_BLOCK because the two answer different questions —
# how long to wait, and how hard to look while waiting.
WORKER_CLAIM_POLL_GAP=250ms

# Headroom added to WORKER_POLL_DEADLINE to derive a claim lease.
#
# The lease must outlive the longest possible unit of work. If it did not, a
# second consumer could claim a scan whose provider analysis is still running,
# and on the submission path that is the difference between polling an existing
# job and submitting the URL a second time. It is validated at startup rather than
# trusted, so a zero or negative value is a configuration error.
CLAIM_LEASE_HEADROOM=30s

# How many times a stalled scan may be recovered before it is failed outright.
SCAN_MAX_ATTEMPTS=3

# How long a verdict may be served as fresh. The TTL index reaps the document
# at the same instant, so this is the real retention period of a verdict.
ASSESSMENT_TTL=24h

# --- abuse controls (ADR 0014) ---------------------------------------------
# There is no authentication in v1. These are the only controls between a
# public URL and the provider quota.
#
# The counters are in-process, which has two consequences worth stating plainly:
# the effective limit is per-replica, and counters reset on restart. Neither is
# acceptable against a hard financial ceiling at scale — if this deployment ever
# runs more than one replica, move the counters to a shared store. Within a
# single process the behaviour is exactly as before.
#
# Per-source request rate. Subject is the client address; X-Forwarded-For is
# deliberately ignored, because honouring a client-supplied header would let
# any caller choose their own key and disable the limit.
RATE_LIMIT_PER_MINUTE=60

# Status polling is bounded separately and much more generously: a client
# legitimately polls a pending scan repeatedly, and this endpoint spends no
# provider quota.
RATE_LIMIT_POLL_PER_MINUTE=600

# Per-fingerprint submission rate. This is the control that actually protects
# quota, because it works with no client identity at all and so is unaffected
# by shared NAT egress, which defeats per-IP limits.
#
# Charged only when a submission actually creates a scan, so a cached hit costs
# nothing.
FINGERPRINT_SUBMIT_LIMIT=10
FINGERPRINT_SUBMIT_WINDOW=1h

# --- protection ruleset -----------------------------------------------------
# Generated in the worker and served by GET /api/v1/get-all. See
# docs/security-and-privacy.md §6 and docs/decisions/0018-ruleset-thresholds-and-scope.md
#
# A verdict never becomes a rule on its own. Only `malicious` is ever eligible,
# and even then only with corroboration: a count of DISTINCT url fingerprints,
# so rescanning one URL many times is one finding, not many.
RULESET_ENABLED=true

# How broad a published rule may ever be. This is the primary safety valve:
# at exact_url a rule can only ever cover one scheme://host/path, whatever the
# corroboration thresholds say.
#
#   exact_url           one scheme://host/path (default, most conservative)
#   url_prefix          one path prefix on one host
#   registrable_domain  the registrable domain AND its subdomains
#
# 2/3/5 are a judgement, not a derivation: they need ratification before any real
# user is protected by a generated rule. See ADR 0018.
RULESET_MAX_SCOPE=exact_url
RULESET_MIN_CORROBORATION=2
RULESET_MIN_CORROBORATION_PREFIX=3
RULESET_MIN_CORROBORATION_DOMAIN=5

# Cap on rules in one snapshot. When it is reached the BROADEST rules are
# dropped first: a host-wide rule and a single-URL rule protect the same host,
# so keeping the narrower one is both safer and more informative.
RULESET_MAX_RULES=5000

# Chrome caps regular-expression rules at 1000 per ruleset, well below the total
# rule limit. Exceeding it makes Chrome IGNORE the ruleset rather than reject it,
# so a client would appear up to date while carrying no protection. Do not raise.
RULESET_MAX_REGEX_RULES=1000

# What an emitted rule does.
#
#   block     refuse the request outright (default)
#   redirect  send it to the extension page named by RULESET_REDIRECT_PATH
#
# A redirect is restricted to main_frame and sub_frame: replacing a sub-resource
# with an HTML page breaks the page rather than protecting it. Where a block and
# a redirect rule both match, Chrome resolves to block at equal priority.
#
# A redirect additionally requires the client to declare the page in its
# manifest web_accessible_resources, or Chrome refuses to install the ruleset.
RULESET_ACTION=block
RULESET_REDIRECT_PATH=/locked.html

# Which request types a rule applies to.
#
#   navigation            main_frame, sub_frame only
#   navigation_and_active the above plus script, xmlhttprequest, ping,
#                          websocket, webtransport  (default)
#   all_subresources      every Chrome resource type
#
# resourceTypes is never omitted: Chrome treats an absent list as "every type
# except main_frame", which would silently stop a rule blocking navigation.
RULESET_RESOURCE_PROFILE=navigation_and_active

# Chrome's rule priority. One value for every rule, so Chrome's documented
# tie-break (block before redirect at equal priority) decides the outcome.
RULESET_PRIORITY=1

# How often the worker rebuilds. A rebuild that produces identical rules does
# not move the version, so an extra rebuild is harmless but not free.
RULESET_REBUILD_INTERVAL=60s

# --- API documentation ------------------------------------------------------
# Serves Swagger UI at http://localhost:8080/docs/ and the raw contract at
# http://localhost:8080/openapi.yaml. No secret is involved: the document
# describes an unauthenticated API and contains no credential.
#
# Set to false to remove both endpoints. The API is unaffected either way.
API_DOCS_ENABLED=true

# Host UID/GID so the `go` dev service writes files you own.
# Check with: id -u && id -g
LOCAL_UID=1000
LOCAL_GID=1000