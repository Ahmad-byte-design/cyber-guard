# Keep the build context small and prevent host artefacts leaking into images.

# Version control
.git
.gitignore

# Local secrets and overrides
.env
.env.*
!.env.example

# Documentation lives outside the build context
docs/
*.md

# Go build and test artefacts
bin/
dist/
*.exe
*.test
coverage.out
coverage.html

# Editor and OS noise
.vscode/
.idea/
.DS_Store

# Docker's own files, to avoid recursive context confusion
Dockerfile
.dockerignore
docker-compose.yml
compose.yaml